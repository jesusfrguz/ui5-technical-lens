{
  "name": "ui5-technical-lens",
  "version": "1.7.9",
  "private": true,
  "description": "Chrome extension for SAPUI5 view and fragment overlays",
  "author": {
    "name": "Jesús Franco Guzmán",
    "url": "https://www.linkedin.com/in/jesus-franco-guzman"
  },
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "test:install-browser": "node tests/install-browser.cjs",
    "test:browser": "node tests/browser.cjs",
    "demo": "node tools/serve.cjs",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/package.ps1",
    "test:devtools": "node tests/devtools-browser.cjs",
    "test:reload": "node tests/reload-browser.cjs",
    "test:updates": "node tests/updates-browser.cjs"
  },
  "devDependencies": {
    "acorn": "8.19.0",
    "playwright": "^1.56.1"
  }
}
