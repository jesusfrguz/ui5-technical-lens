<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core" controllerName="demo.controller.Main" displayBlock="true">
  <App><Page title="Pedidos · Technical Lens" class="sapUiContentPadding">
    <headerContent><Button id="openDialog" text="Abrir diálogo" icon="sap-icon://inspect" press="onOpenDialog"/></headerContent>
    <content>
      <VBox class="sapUiMediumMarginBottom">
        <Title text="Tu aplicación, con contexto técnico" level="H1"/>
        <Text text="Activa Technical Lens desde la barra de Chrome. Azul: vistas. Violeta: fragmentos."/>
      </VBox>
      <core:Fragment fragmentName="demo.fragment.Summary" type="XML"/>
      <core:Fragment fragmentName="demo.fragment.Stats" type="XML"/>
      <Panel headerText="Campos con bindings · JSON y OData" class="sapUiSmallMarginTop">
        <VBox class="sapUiSmallMargin" binding="{sales>/Orders('4500001234')}">
          <Label text="Cliente · OData V2"/><Input id="customerField" value="{sales>CustomerName}" editable="{ui>/editable}"/>
          <Label text="Nota · JSON por defecto"/><Input id="noteField" value="{/note}"/>
          <Text id="compositeField" text="{= ${ui>/state} + ' · ' + ${/note} }"/>
        </VBox>
        <VBox class="sapUiSmallMargin" binding="{catalog>/Products('P1')}">
          <Label text="Producto · OData V4"/><Input id="productField" value="{catalog>Name}"/>
        </VBox>
      </Panel>
      <VBox id="detailsHost" class="sapUiMediumMarginTop"><Button id="loadDetails" text="Cargar una segunda vista" press="onLoadDetails"/></VBox>
      <List headerText="Pedidos recientes" class="sapUiMediumMarginTop">
        <StandardListItem title="Pedido 4500001234" description="Material de oficina · Madrid" info="Pendiente" infoState="Warning"/>
        <StandardListItem title="Pedido 4500001235" description="Equipamiento · Barcelona" info="Aprobado" infoState="Success"/>
        <StandardListItem title="Pedido 4500001236" description="Servicios · Valencia" info="Aprobado" infoState="Success"/>
        <StandardListItem title="Pedido 4500001237" description="Mantenimiento · Sevilla" info="Pendiente" infoState="Warning"/>
        <StandardListItem title="Pedido 4500001238" description="Licencias · Bilbao" info="Aprobado" infoState="Success"/>
        <StandardListItem title="Pedido 4500001239" description="Consultoría · Málaga" info="Aprobado" infoState="Success"/>
        <StandardListItem title="Pedido 4500001240" description="Hardware · Zaragoza" info="Pendiente" infoState="Warning"/>
        <StandardListItem title="Pedido 4500001241" description="Servicios · Alicante" info="Aprobado" infoState="Success"/>
        <StandardListItem title="Pedido 4500001242" description="Equipamiento · Murcia" info="Aprobado" infoState="Success"/>
        <StandardListItem title="Pedido 4500001243" description="Material · Vigo" info="Pendiente" infoState="Warning"/>
      </List>
    </content>
  </Page></App>
</mvc:View>
